# -----------------------------------------------------------------------------
# FileX Environment Variables Example
# Copy this file to .env.local and fill in the values.
# -----------------------------------------------------------------------------

# Database (Supabase PostgreSQL)
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key for administrative tasks (Keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Database Connection URL for Drizzle ORM
# Format: postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Authentication (Better Auth)
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=your-random-secret-key-at-least-32-characters
# The base URL of your application
BETTER_AUTH_URL=http://localhost:3000

# Site Configuration
# The public URL of your site (used for metadata and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated origins permitted to call authenticated APIs cross-origin.
# Keep this limited to trusted application origins; do not use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cron Security
# Secret for protecting cron job endpoints
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-32-character-secret

# Environment
# Set to 'development', 'production', or 'test'
NODE_ENV=development

# -----------------------------------------------------------------------------
# Billing (Stripe)
# Leave unset to run FileX without billing — checkout/portal routes degrade
# gracefully and the app stays on the free plan.
# -----------------------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys (use a test key while developing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Signing secret for the /api/billing/webhook endpoint (from `stripe listen` or the Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Recurring Price IDs for each paid plan
STRIPE_PRICE_ID_PRO=price_your_pro_plan_price_id
STRIPE_PRICE_ID_ENTERPRISE=price_your_enterprise_plan_price_id

# -----------------------------------------------------------------------------
# Transactional Email (Resend)
# Leave unset to run without email — notifications are logged and skipped
# instead of failing.
# -----------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Verified "from" address/display name for outgoing mail
EMAIL_FROM=FileX <notifications@knimex.space>

# -----------------------------------------------------------------------------
# AI Development Note:
# FileX was developed using IBM Watson for prototyping AI-powered risk 
# assessment modules. Future enhancements should respect this technical heritage.
# -----------------------------------------------------------------------------
