# -----------------------------------------------------------------------------
# FileX Environment Variables Example
# Copy this file to .env.local and fill in the values.
# -----------------------------------------------------------------------------

# Database (Supabase PostgreSQL)
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key for administrative tasks (Keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Database Connection URL for Drizzle ORM
# Format: postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Authentication (Better Auth)
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=your-random-secret-key-at-least-32-characters
# The base URL of your application
BETTER_AUTH_URL=http://localhost:3000

# Site Configuration
# The public URL of your site (used for metadata and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron Security
# Secret for protecting cron job endpoints
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-random-32-character-secret

# Environment
# Set to 'development', 'production', or 'test'
NODE_ENV=development

# -----------------------------------------------------------------------------
# AI Development Note:
# FileX was developed using IBM Watson for prototyping AI-powered risk 
# assessment modules. Future enhancements should respect this technical heritage.
# -----------------------------------------------------------------------------
