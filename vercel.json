{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run pre-deploy",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/gitapp",
      "destination": "https://gitapp.org",
      "permanent": true
    },
    {
      "source": "/gitapp/:match*",
      "destination": "https://gitapp.org/:match*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/bizdex",
      "destination": "https://bizdex.knimex.com/"
    },
    {
      "source": "/bizdex/:match*",
      "destination": "https://bizdex.knimex.com/:match*"
    }
  ],
  "crons": [
    {
      "path": "/filex/api/cron/keep-alive",
      "schedule": "0 0 * * *"
    }
  ]
}
